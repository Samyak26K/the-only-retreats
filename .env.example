# Database (PostgreSQL)
# Use the Supabase transaction pooler (6543) with pgbouncer + an explicit pool size on Vercel
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
# CMS (Sanity)
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN="your_sanity_api_token"

# Media (Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"

# Email (Resend)
RESEND_API_KEY="re_..."

# Payments (Razorpay)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Payments (Stripe - future-ready)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."

# Order notifications (optional; failures are logged, never block an order)
# Google Apps Script web-app URL that appends a row per order (see docs/order-notifications.md)
ORDERS_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"
# CallMeBot WhatsApp: phone with country code (e.g. 919876543210) and the API key CallMeBot sends you
CALLMEBOT_PHONE=""
CALLMEBOT_APIKEY=""
